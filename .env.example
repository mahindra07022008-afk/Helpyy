# Public browser configuration. Never put service-role or secret keys here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Worker bindings (public key only; every query is subject to RLS)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Optional. The UPI ID buyers pay (public; shown at checkout). Leave unset to keep
# payments and payouts switched off. Not a secret, but it is where money is sent.
UPI_ID=
# Legacy Express server only, not used by the Cloudflare deployment:
DATABASE_URL=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
APP_ORIGIN=
PORT=5000
BASE_PATH=/
# Deployment script only; never prefix the token with VITE_.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
